---
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'light' | 'outline-light';
  size?: 'md' | 'lg';
  arrow?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', arrow = false, class: className } = Astro.props;

const variants = {
  primary: 'bg-brand-deep text-white hover:bg-brand shadow-soft',
  secondary: 'bg-white text-brand-deep border border-line-strong hover:border-brand-deep',
  ghost: 'text-brand-deep hover:text-brand px-0!',
  light: 'bg-white text-brand-deep hover:bg-accent-wash',
  'outline-light': 'text-white border border-white/35 hover:border-white hover:bg-white/5',
};

const sizes = {
  // Ajuste de línea solo cuando hace falta: la media query en rem crece con el tamaño de letra del navegador
  // (20rem = 320 px con letra normal, 640 px con letra al 200 %). Con letra normal el botón se comporta como
  // siempre (una línea); en pantalla estrecha con texto ampliado parte el texto y baja la flecha en vez de desbordar.
  // shrink-0 + max-w-full: en una fila flexible no se estrecha y nunca supera su contenedor.
  // Altura mínima (no fija) + relleno vertical: en condiciones normales mide igual (44 / 52 px),
  // pero si el texto no cabe en una línea (texto al 200 %, pantallas estrechas) el botón crece en vez de desbordar.
  // El relleno lateral se limita con vw: idéntico en condiciones normales (20 / 24 px desde 320 px),
  // pero con el texto ampliado no se duplica y deja sitio a la etiqueta en pantallas estrechas.
  md: 'min-h-11 px-[min(1.25rem,6.25vw)] py-2 text-[0.9375rem]',
  lg: 'min-h-13 px-[min(1.5rem,7.5vw)] py-3 text-base',
};
---

<a
  href={href}
  class:list={[
    'btn group ease-out-soft inline-flex max-w-full shrink-0 flex-wrap items-center justify-center gap-x-2 gap-y-1 rounded-lg font-semibold text-center min-[20rem]:flex-nowrap min-[20rem]:whitespace-nowrap',
    variants[variant],
    sizes[size],
    className,
  ]}
>
  {/* Caso extremo (pantalla muy estrecha + texto ampliado): si una palabra no cabe, se separa por sílabas (lang="es") en vez de desbordar. */}
  <span class="min-w-0 hyphens-auto min-[20rem]:min-w-auto"><slot /></span>
  {
    arrow && (
      <Icon name="arrow-right" size={18} class="btn-arrow" />
    )
  }
</a>

<style>
  /* Color con transición suave (ease); respuesta al pulsar inmediata (escala .97 en 140 ms, curva de salida fuerte).
     Es un control, no contenido: sin espera de doble toque ni selección del texto al mantener pulsado. */
  .btn {
    touch-action: manipulation;
    /* Sin el destello gris del navegador al tocar: la respuesta es la escala de :active. */
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    user-select: none;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      opacity 120ms ease-out,
      transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .btn:active {
    transform: scale(0.97);
  }

  /* Flecha: se desplaza solo con hover real (puntero preciso); en táctil no queda desplazada tras tocar. */
  :global(.btn-arrow) {
    transition: transform 200ms var(--ease-out-soft);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn:hover :global(.btn-arrow) {
      transform: translateX(2px);
    }
  }

  /* Movimiento reducido: la respuesta al pulsar se mantiene, pero sin movimiento (solo opacidad). */
  @media (prefers-reduced-motion: reduce) {
    .btn:active {
      transform: none;
      opacity: 0.85;
    }
  }
</style>
