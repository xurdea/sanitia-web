---
import type { CollectionEntry } from 'astro:content';
import MediaFrame from './MediaFrame.astro';
import Icon from './Icon.astro';
import { formatDate } from '../lib/format';

interface Props {
  entry: CollectionEntry<'recursos'>;
  headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel: Heading = 'h3' } = Astro.props;
const { title, summary, category, date, readingTime, image, imageAlt } = entry.data;
---

<article class="group relative flex flex-col">
  {
    image && (
      <MediaFrame
        src={image}
        alt={imageAlt ?? ''}
        aspect="16 / 10"
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="border-line border"
      />
    )
  }
  <div class:list={['flex items-center gap-3 text-sm', image ? 'mt-6' : 'border-line border-t pt-6']}>
    <span class="text-accent-strong font-semibold">{category}</span>
    <span aria-hidden="true" class="bg-line-strong size-1 rounded-full"></span>
    <span class="text-muted inline-flex items-center gap-1.5">
      <Icon name="clock" size={14} />
      {readingTime} min de lectura
    </span>
  </div>
  <Heading class="group-hover:text-brand mt-3 text-xl leading-snug font-bold transition-colors">
    <a href={`/recursos/${entry.id}`} class="after:absolute after:inset-0 after:content-['']">
      {title}
    </a>
  </Heading>
  <p class="text-muted mt-3 leading-relaxed">{summary}</p>
  <p class="text-muted mt-5 text-sm">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
  </p>
</article>
