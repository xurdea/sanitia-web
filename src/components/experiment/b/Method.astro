---
/**
 * EXPERIMENTO A/B · Variante B (SanitIA + principios de apple-design-skill).
 *
 * Sección protagonista con una sola idea: el método es un recorrido, no un catálogo
 * de herramientas. El recorrido (experimentMethod.flow) se dibuja con la
 * "línea de verificación": trazo turquesa fino que conecta los pasos y termina
 * en el nodo de resultado verificado.
 *
 * Movimiento: mejora progresiva ligada al scroll (animation-timeline: view()).
 * Estado por defecto = estado final (línea dibujada, nodos activos, texto visible).
 * Sin soporte o con prefers-reduced-motion no se anima nada. Cero JavaScript.
 *
 * Las cuatro fases oficiales llegan de methodSteps (fuente única) vía experimentMethod.phases.
 */
import Button from '../../Button.astro';
import Icon from '../../Icon.astro';
import { experimentMethod as method } from '../../../data/experiment';

const lastFlow = method.flow.length - 1;
---

<section class="method-b bg-surface section-y" aria-labelledby="metodo-b-title">
  <div class="container-site">
    <!-- Cabecera: titular grande + entradilla -->
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-12">
      <div class="lg:col-span-7">
        <p class="eyebrow">{method.kicker}</p>
        <h2 id="metodo-b-title" class="method-b-title mt-5">{method.title}</h2>
      </div>
      <p class="text-lead text-muted max-w-[34rem] lg:col-span-5 lg:pb-2">{method.intro}</p>
    </div>

    <!-- Recorrido: panel elevado con la línea de verificación -->
    <div
      class="border-line shadow-soft mt-10 rounded-[var(--radius-card)] border bg-white px-5 py-8 sm:px-8 sm:py-10 lg:mt-16 lg:px-10 lg:py-12"
    >
      <ol class="flow-b">
        {
          method.flow.map((step, i) => (
            <li
              class:list={['flow-b-step', { 'is-result': i === lastFlow }]}
              style={`--p0: ${i / lastFlow}; --p1: ${(i + 1) / lastFlow};`}
            >
              {i < lastFlow && (
                <span class="flow-b-seg" aria-hidden="true">
                  <span class="flow-b-seg-fill" />
                </span>
              )}
              <span class="flow-b-node" aria-hidden="true">
                {i === lastFlow && <Icon name="check" size={16} class="stroke-[2.5]" />}
              </span>
              <div class="flow-b-body">
                <p class="text-muted font-display text-xs font-semibold tabular-nums" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </p>
                <h3 class="flow-b-name">{step.name}</h3>
                <p class="text-muted mt-2 text-[0.9375rem] leading-relaxed">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Fases oficiales (secundario) + enlace -->
    <div class="border-line mt-12 grid gap-8 border-t pt-10 lg:mt-16 lg:grid-cols-12 lg:gap-12 lg:pt-12">
      <div class="lg:col-span-4">
        <h3 class="font-display text-brand-deep text-xl font-bold tracking-tight">{method.phasesLabel}</h3>
        <Button href={method.cta.href} variant="secondary" arrow class="method-b-btn mt-6">{method.cta.label}</Button>
      </div>
      <ol class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:col-span-8 xl:grid-cols-4">
        {
          method.phases.map((phase, i) => (
            <li class="border-line border-l pl-4">
              <p class="text-muted font-display text-xs font-semibold tabular-nums" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </p>
              <p class="font-display text-brand-deep mt-1 font-bold">{phase.name}</p>
              <p class="text-muted mt-1 text-sm leading-relaxed">{phase.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .method-b-title {
    font-size: clamp(2.125rem, 1.25rem + 3.4vw, 3.75rem);
    line-height: 1.04;
    letter-spacing: -0.034em;
    font-weight: 750;
    max-width: 16ch;
  }

  :global(.method-b-btn:active) {
    transform: scale(0.98);
  }

  /* ---------- Recorrido ---------- */
  .flow-b {
    --node: 1.5rem;
    --gap: 1.75rem;
    /* Tramo del scroll en el que se dibuja la línea (mejora progresiva) */
    --r0: 10%;
    --r1: 48%;
    display: grid;
    gap: var(--gap);
    view-timeline: --flow-b block;
  }

  .flow-b-step {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) 1fr;
    column-gap: 1rem;
  }

  .flow-b-name {
    margin-top: 0.25rem;
    font-size: 1.1875rem;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  /* Nodo: punto de control de la línea */
  .flow-b-node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border-radius: 999px;
    background: #fff;
    border: 2px solid currentColor;
    color: var(--color-accent-strong);
  }
  .flow-b-node::after {
    content: '';
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 999px;
    background: currentColor;
  }
  /* Nodo final: único momento azul marino, con la comprobación en turquesa */
  .is-result {
    --node: 2rem;
  }
  .is-result .flow-b-node {
    background: var(--color-brand-deep);
    border-color: var(--color-brand-deep);
    color: var(--color-accent);
  }
  .is-result .flow-b-node::after {
    content: none;
  }
  /* En móvil el nodo final es más grande: se centra en la columna de nodos */
  .flow-b-step:not(.is-result) {
    --col: 2rem;
    grid-template-columns: var(--col) 1fr;
  }
  .flow-b-step:not(.is-result) .flow-b-node {
    margin-inline: auto;
  }

  /* Tramo de línea entre un nodo y el siguiente (móvil: vertical) */
  .flow-b-seg {
    position: absolute;
    left: calc(1rem - 1px);
    top: calc(0.75rem);
    width: 2px;
    height: calc(100% + var(--gap));
    background: var(--color-line);
    overflow: hidden;
  }
  .flow-b-seg-fill {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform-origin: top center;
  }

  /* Escritorio: recorrido horizontal en cinco columnas */
  @media (width >= 64rem) {
    .flow-b {
      --gap: 2rem;
      --r0: 12%;
      --r1: 34%;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .flow-b-step,
    .flow-b-step:not(.is-result) {
      grid-template-columns: 1fr;
      grid-template-rows: 2rem auto;
      row-gap: 1.25rem;
    }
    .flow-b-step .flow-b-node,
    .flow-b-step:not(.is-result) .flow-b-node {
      align-self: center;
      margin-inline: 0;
    }
    .flow-b-step:not(.is-result) .flow-b-node {
      margin-left: 0.25rem;
    }
    .flow-b-seg {
      left: 1rem;
      top: calc(1rem - 1px);
      width: calc(100% + var(--gap));
      height: 2px;
    }
    .flow-b-seg-fill {
      transform-origin: left center;
    }
  }

  /* ---------- Mejora progresiva: la línea se dibuja al hacer scroll ---------- */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .flow-b-seg-fill {
        animation: flow-b-draw-y linear both;
        animation-timeline: --flow-b;
        animation-range: cover calc(var(--r0) + (var(--r1) - var(--r0)) * var(--p0)) cover
          calc(var(--r0) + (var(--r1) - var(--r0)) * var(--p1));
      }
      .flow-b-step:not(.is-result) .flow-b-node {
        animation: flow-b-node-on linear both;
        animation-timeline: --flow-b;
        animation-range: cover calc(var(--r0) + (var(--r1) - var(--r0)) * var(--p0) - 1%) cover
          calc(var(--r0) + (var(--r1) - var(--r0)) * var(--p0) + 1%);
      }
      .is-result .flow-b-node {
        animation: flow-b-result-on linear both;
        animation-timeline: --flow-b;
        animation-range: cover calc(var(--r1) - 1%) cover calc(var(--r1) + 2%);
      }

      @media (width >= 64rem) {
        .flow-b-seg-fill {
          animation-name: flow-b-draw-x;
        }
      }
    }
  }

  @keyframes flow-b-draw-y {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes flow-b-draw-x {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes flow-b-node-on {
    from {
      color: var(--color-line-strong);
    }
  }
  @keyframes flow-b-result-on {
    from {
      background: #fff;
      border-color: var(--color-line-strong);
      color: var(--color-line-strong);
    }
  }
</style>
