---
import FounderCard from '../FounderCard.astro';
import Icon from '../Icon.astro';
import { metrics, testimonials } from '../../data/credibility';

const pillars = [
  { icon: 'building', label: 'Tecnología sanitaria' },
  { icon: 'workflow', label: 'Sistemas de información' },
  { icon: 'layers', label: 'Transformación digital' },
  { icon: 'lightbulb', label: 'IA aplicada en entornos profesionales' },
] as const;
---

<section class="section-y" aria-labelledby="credibilidad-title">
  <div class="container-site grid gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-6" data-reveal>
      <p class="eyebrow mb-4">Experiencia</p>
      <h2 id="credibilidad-title" class="text-h2">Tecnología sanitaria, IA y experiencia profesional</h2>
      <p class="text-lead text-muted mt-6">
        SanitIA nace de la experiencia profesional en tecnología sanitaria, sistemas de información y transformación
        digital, combinada con la aplicación práctica de herramientas de inteligencia artificial en entornos profesionales.
      </p>
      <FounderCard class="mt-10 max-w-xl" />
    </div>

    <div class="lg:col-span-5 lg:col-start-8" data-reveal>
      <ul class="divide-line border-line divide-y border-y">
        {
          pillars.map((pillar) => (
            <li class="flex items-center gap-4 py-5">
              <span class="bg-accent-wash text-brand inline-flex size-11 items-center justify-center rounded-lg">
                <Icon name={pillar.icon} size={22} />
              </span>
              <span class="font-display text-brand-deep text-lg font-semibold">{pillar.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    {
      metrics.length > 0 && (
        <dl class="border-line grid gap-8 border-t pt-10 sm:grid-cols-2 lg:col-span-12 lg:grid-cols-4">
          {metrics.map((metric) => (
            <div class="flex flex-col-reverse">
              <dt class="text-muted mt-1 text-sm">{metric.label}</dt>
              <dd class="font-display text-brand-deep text-4xl font-bold">{metric.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      testimonials.length > 0 && (
        <div class="grid gap-6 md:grid-cols-2 lg:col-span-12">
          {testimonials.map((t) => (
            <figure class="border-line rounded-xl border bg-white p-8">
              <blockquote class="text-ink text-lg leading-relaxed">“{t.quote}”</blockquote>
              <figcaption class="mt-6 text-sm">
                <span class="text-brand-deep font-semibold">{t.name}</span>
                <span class="text-muted"> · {t.role}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </div>
</section>
