---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
  tone?: 'dark' | 'light';
  class?: string;
}

const { eyebrow, title, intro, align = 'left', as: Tag = 'h2', tone = 'dark', class: className } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center', className]}>
  {eyebrow && <p class:list={['eyebrow mb-4', tone === 'light' && 'text-accent!']}>{eyebrow}</p>}
  <Tag class:list={[Tag === 'h1' ? 'text-display' : 'text-h2', tone === 'light' && 'text-white']}>{title}</Tag>
  {
    intro && (
      <p class:list={['text-lead mt-5', tone === 'light' ? 'text-slate-300' : 'text-muted', align === 'center' && 'mx-auto']}>
        {intro}
      </p>
    )
  }
  <slot />
</div>
