---
import { Image } from 'astro:assets';
import { founder, testimonials } from '../../data/credibility';
import { credibility } from '../../data/home';

// La fotografía se añade en credibility.ts (founder.photo). Sin ella se muestra un monograma decorativo.
const photo = founder.photo;
---

<section class="border-line border-y bg-white py-12 sm:py-16 lg:py-24" aria-labelledby="credibilidad-title">
  <div class="container-site grid gap-10 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7" data-reveal>
      <p class="eyebrow mb-4">Quién está detrás</p>
      <h2 id="credibilidad-title" class="text-h2">{credibility.title}</h2>

      <div class="mt-8 flex items-center gap-4 sm:gap-5">
        {
          photo ? (
            <Image
              src={photo}
              alt={`Retrato de ${credibility.founderName}`}
              width={96}
              height={96}
              densities={[1, 2]}
              class="size-16 shrink-0 rounded-full object-cover sm:size-20"
            />
          ) : (
            <span
              aria-hidden="true"
              class="bg-brand-deep font-display text-accent-soft inline-flex size-16 shrink-0 items-center justify-center rounded-full text-xl font-bold sm:size-20 sm:text-2xl"
            >
              {credibility.founderInitials}
            </span>
          )
        }
        <p>
          <span class="font-display text-brand-deep block text-lg font-bold sm:text-xl">{credibility.founderName}</span>
          <span class="text-accent-strong mt-0.5 block text-[0.9375rem] font-semibold">{credibility.founderRole}</span>
        </p>
      </div>

      <div class="text-muted mt-6 max-w-2xl space-y-4 leading-relaxed sm:text-[1.0625rem]">
        {credibility.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <dl
      class="divide-line border-line grid divide-y border-y sm:grid-cols-3 sm:divide-x sm:divide-y-0 lg:col-span-4 lg:col-start-9 lg:grid-cols-1 lg:divide-x-0 lg:divide-y lg:self-center"
      data-reveal
    >
      {
        credibility.highlights.map((item) => (
          <div class="flex flex-col-reverse py-4 sm:px-5 sm:py-6 sm:first:pl-0 lg:px-0 lg:py-7">
            <dt class="text-muted mt-1 text-[0.9375rem]">{item.label}</dt>
            <dd class="font-display text-brand-deep text-2xl font-bold tracking-tight sm:text-[1.75rem]">{item.value}</dd>
          </div>
        ))
      }
    </dl>

    {
      testimonials.length > 0 && (
        <div class="grid gap-6 md:grid-cols-2 lg:col-span-12">
          {testimonials.map((t) => (
            <figure class="border-line bg-surface rounded-xl border p-8">
              <blockquote class="text-ink text-lg leading-relaxed">“{t.quote}”</blockquote>
              <figcaption class="mt-6 text-sm">
                <span class="text-brand-deep font-semibold">{t.name}</span>
                <span class="text-muted"> · {t.role}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </div>
</section>
