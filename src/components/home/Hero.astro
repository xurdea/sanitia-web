---
/**
 * Hero de la Home: titular protagonista, columna visual y la tarjeta "Ejemplo de tarea".
 * No repite los datos de los cursos (están en Formación); solo los enlaza.
 *
 * Columna visual:
 * - Sin fotografía (estado actual): panel editorial en azul profundo con los ámbitos del sector
 *   sanitario (CLAUDE.md §8.1) y la tarjeta de ejemplo integrada. Es un diseño terminado, no una reserva.
 * - Con fotografía: foto documental con la tarjeta de ejemplo flotando sobre su borde.
 *
 * Movimiento: el texto (H1 incluido) es estático desde el primer fotograma.
 * Solo se mueven el subrayado de "trabajo real" (se dibuja una vez) y la tarjeta de ejemplo.
 */
import type { ImageMetadata } from 'astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import MediaFrame from '../MediaFrame.astro';
import ExampleTask from './ExampleTask.astro';
import { hero } from '../../data/home';

/**
 * Fotografía real del Hero (pendiente). Para usarla:
 *   1. Guardarla en src/assets/home/ (p. ej. hero-documento.jpg, vertical, ≥ 1600 px de alto).
 *   2. Importarla aquí:  import heroImage from '../../assets/home/hero-documento.jpg';
 *   3. Borrar la línea `const heroImage = undefined;`.
 * La proporción la decide --hero-photo-aspect (16/9 en móvil y tableta, 4/5 en escritorio).
 */
const heroImage: ImageMetadata | undefined = undefined;

// Separa el titular para unir y subrayar "trabajo real" sin reescribir el texto.
const [titleBefore, titleAfter = ''] = hero.title.split(hero.titleEmphasis);
---

<section class="hero border-line relative border-y bg-white" aria-labelledby="hero-title">
  <div class="container-site grid items-center gap-y-10 pt-10 pb-16 sm:pt-14 lg:grid-cols-12 lg:grid-rows-[1fr_auto] lg:gap-x-12 lg:pt-20 lg:pb-24 xl:gap-x-16">
    <!-- Texto: estático (sin animación de entrada) -->
    <div class="lg:col-span-7 lg:col-start-1 lg:row-start-1 lg:self-end">
      <p class="eyebrow">{hero.eyebrow}</p>

      <h1 id="hero-title" class="hero-title mt-5 sm:mt-6">
        {titleBefore}<span class="hero-emphasis">{hero.titleEmphasis}</span>{titleAfter}
      </h1>

      <p class="text-lead text-muted mt-6 max-w-[34rem] sm:mt-8">{hero.lead}</p>

      <div class="mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row">
        <Button href={hero.primary.href} size="lg" arrow>{hero.primary.label}</Button>
        <Button href={hero.secondary.href} size="lg" variant="secondary">{hero.secondary.label}</Button>
      </div>
    </div>

    <!-- Visual (también en móvil): foto + ejemplo flotante, o panel editorial con el ejemplo integrado -->
    <div class="hero-visual relative lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:self-center">
      {
        heroImage ? (
          <>
            <MediaFrame
              src={heroImage}
              alt={hero.photoAlt}
              aspect="var(--hero-photo-aspect)"
              priority
              sizes="(min-width: 1024px) 40vw, 100vw"
              class="border-line border"
            />
            <ExampleTask class="hero-example" />
          </>
        ) : (
          <div class="hero-panel">
            <span aria-hidden="true" class="hero-panel-bar" />
            <p id="hero-areas-label" class="hero-panel-label">{hero.areasLabel}</p>
            <ul class="hero-areas" aria-labelledby="hero-areas-label">
              {hero.areas.map((area) => <li>{area}</li>)}
            </ul>
            <ExampleTask class="hero-panel-example" />
          </div>
        )
      }
    </div>

    <!-- Acceso discreto a los dos cursos, sin repetir sus datos -->
    <ul class="border-line flex flex-col border-t pt-1.5 sm:flex-row sm:gap-8 lg:col-span-7 lg:col-start-1 lg:row-start-2 lg:self-start">
      {
        hero.courses.map((course) => (
          <li>
            <a href={course.href} class="course-link text-brand-deep hover:text-brand group inline-flex min-h-11 items-center gap-1.5 text-[0.9375rem] font-semibold">
              {course.label}
              <Icon name="arrow-right" size={16} class="course-arrow text-accent-strong" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero-title {
    /*
     * "aplicada al trabajo real" mide ~10,1em (≈16ch). Con 16,5ch de ancho máximo, el ajuste línea a
     * línea da "Inteligencia artificial / aplicada al trabajo real / en sanidad". `balance` no sirve
     * aquí: iguala líneas y elige "… / artificial aplicada al / trabajo real en sanidad".
     * `pretty` conserva esa composición y evita palabras huérfanas en los anchos más estrechos.
     */
    max-width: 16.5ch;
    /* Por debajo de ~375 px, 8,6vw mantiene "aplicada al trabajo real" en una sola línea. */
    font-size: min(clamp(2rem, 1.1rem + 3.1vw, 3.75rem), 8.6vw);
    line-height: 1.04;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--color-brand-deep);
    text-wrap: pretty;
  }

  /* "trabajo real" nunca se parte; su subrayado es la línea de verificación (turquesa = señal). */
  .hero-emphasis {
    position: relative;
    white-space: nowrap;
    color: var(--color-brand);
  }

  .hero-emphasis::after {
    content: '';
    position: absolute;
    left: 0.02em;
    right: 0.02em;
    /* Bajo la línea base: no roza el descendente de la «j». */
    bottom: -0.05em;
    height: 0.07em;
    min-height: 3px;
    border-radius: 2px;
    background: var(--color-accent);
    transform-origin: left center;
  }

  /* Proporción de la foto sin forzar estilos de MediaFrame. Mientras sea una reserva, en móvil y tableta
     es apaisada (16/9) para no dominar el Hero; en escritorio, vertical. */
  .hero-visual {
    --hero-photo-aspect: 16 / 9;
  }

  .hero-visual :global(.hero-example) {
    position: relative;
    margin: -3.5rem 0.75rem 0;
  }

  @media (width >= 40rem) {
    .hero-visual :global(.hero-example) {
      max-width: 21rem;
      margin: -5rem 0 0 1.5rem;
    }
  }

  @media (width >= 64rem) {
    .hero-visual {
      --hero-photo-aspect: 4 / 5;
    }

    /* La tarjeta flota sobre el borde izquierdo de la foto sin invadir el texto. */
    .hero-visual :global(.hero-example) {
      position: absolute;
      left: -1.5rem;
      bottom: -2rem;
      width: 19.5rem;
      margin: 0;
    }
  }

  @media (width >= 80rem) {
    .hero-visual :global(.hero-example) {
      left: -2.5rem;
    }
  }

  /* Panel editorial (sin fotografía): azul profundo, ámbitos del sector y la tarjeta de ejemplo dentro. */
  .hero-panel {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-brand-deep);
    padding: 1.75rem 1rem 1rem;
  }

  /* Misma marca turquesa que las tarjetas destacadas de la web. */
  .hero-panel-bar {
    position: absolute;
    top: 0;
    left: 1rem;
    width: 4rem;
    height: 4px;
    background: var(--color-accent);
  }

  /* Cian claro sobre azul profundo: ≈ 11:1. */
  .hero-panel-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-soft);
  }

  /* Cada ámbito lleva su propio punto delante: al partirse la línea no queda ningún separador colgando. */
  .hero-areas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.125rem;
    margin-top: 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.95rem + 0.9vw, 1.5rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--color-white);
  }

  .hero-areas li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  /* Punto decorativo (lo pinta CSS; los lectores de pantalla ya anuncian una lista). */
  .hero-areas li::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--color-accent);
  }

  .hero-panel :global(.hero-panel-example) {
    margin-top: 1.5rem;
  }

  @media (width >= 40rem) {
    .hero-panel {
      padding: 2.25rem 1.75rem 1.75rem;
    }

    .hero-panel-bar {
      left: 1.75rem;
    }

    .hero-panel :global(.hero-panel-example) {
      margin-top: 2rem;
    }
  }

  /* Tableta: el panel ocupa todo el ancho; ámbitos en columna a la izquierda y ejemplo a la derecha. */
  @media (width >= 48rem) and (width < 64rem) {
    .hero-panel {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 22rem;
      grid-template-rows: auto 1fr;
      column-gap: 2rem;
      align-items: start;
    }

    .hero-areas {
      flex-direction: column;
      gap: 0.375rem;
      grid-column: 1;
    }

    .hero-panel :global(.hero-panel-example) {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin-top: 0;
    }
  }

  @media (width >= 64rem) {
    .hero-panel {
      padding: 2.5rem 2rem 2rem;
    }

    .hero-panel-bar {
      left: 2rem;
    }
  }

  .course-link {
    transition: color 200ms ease, opacity 120ms ease-out;
  }

  /* Respuesta inmediata al tocar (sin movimiento: válida también con movimiento reducido). */
  .course-link:active {
    opacity: 0.7;
  }

  :global(.course-arrow) {
    transition: transform 200ms var(--ease-out-soft);
  }

  /* Hover solo en dispositivos con puntero fino: evita estados pegados en táctil. */
  @media (hover: hover) and (pointer: fine) {
    .course-link:hover :global(.course-arrow) {
      transform: translateX(2px);
    }
  }

  /* El subrayado se dibuja una sola vez; el texto ya es visible desde el inicio. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-emphasis::after {
      animation: emphasis-draw 420ms cubic-bezier(0.23, 1, 0.32, 1) 250ms both;
    }
  }

  @keyframes emphasis-draw {
    from {
      transform: scaleX(0);
    }
  }
</style>
