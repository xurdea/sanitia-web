---
import Button from './Button.astro';

interface Action {
  label: string;
  href: string;
}

interface Props {
  title: string;
  subtitle?: string;
  text?: string;
  primary: Action;
  secondary?: Action;
}

const { title, subtitle, text, primary, secondary } = Astro.props;
---

<section class="section-y">
  <div class="container-site">
    <div class="rounded-card bg-brand-deep relative isolate overflow-hidden px-6 py-16 sm:px-12 md:py-20 lg:px-20" data-reveal>
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10"
        style="background-image: linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px); background-size: 40px 40px; mask-image: linear-gradient(to left, black, transparent 70%);"
      >
      </div>
      <div aria-hidden="true" class="bg-accent absolute top-0 left-0 h-1 w-24"></div>
      <div class="max-w-2xl">
        <h2 class="text-h2 text-white">{title}</h2>
        {subtitle && <p class="font-display text-accent-soft mt-3 text-xl font-semibold md:text-2xl">{subtitle}</p>}
        {text && <p class="text-lead mt-6 text-slate-300">{text}</p>}
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <Button href={primary.href} variant="light" size="lg" arrow>{primary.label}</Button>
          {
            secondary && (
              <Button href={secondary.href} variant="outline-light" size="lg">
                {secondary.label}
              </Button>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
