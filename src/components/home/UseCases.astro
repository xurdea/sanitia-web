---
/**
 * Aplicaciones (dirección editorial): titular en serif y lista tipográfica con filetes finos.
 * Sin antetítulo, sin tarjetas y sin iconos: el texto de cada tarea es el elemento gráfico.
 */
import { applications } from '../../data/home';
---

<section class="py-14 sm:py-20 lg:py-28" aria-labelledby="aplicaciones-title">
  <div class="container-site">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-12" data-reveal>
      <h2 id="aplicaciones-title" class="text-editorial-h2 max-w-[15ch] lg:col-span-7">{applications.title}</h2>
      <p class="text-lead text-muted max-w-[34rem] lg:col-span-5">{applications.intro}</p>
    </div>

    <ul class="tasks mt-10 grid sm:mt-12 sm:grid-cols-2 sm:gap-x-10 lg:mt-16 lg:grid-cols-3 lg:gap-x-12" data-reveal>
      {
        applications.items.map((item) => (
          <li>
            <h3 class="task-title">{item}</h3>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Cada tarea arranca bajo un filete fino, como las entradas de un sumario. */
  .tasks li {
    border-top: 1px solid var(--color-line-strong);
    padding-block: 1.125rem 1.75rem;
  }

  .task-title {
    max-width: 18ch;
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-size: clamp(1.375rem, 1.15rem + 0.8vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.012em;
    font-weight: 500;
    color: var(--color-brand-deep);
    text-wrap: balance;
  }
</style>
