---
import Button from '../Button.astro';
import MediaFrame from '../MediaFrame.astro';
import Icon from '../Icon.astro';
import { featuredCourse } from '../../data/content';

// Sustituible por una fotografía real importada desde src/assets/.
const courseImage = undefined;
---

<section class="section-y bg-white" aria-labelledby="formacion-destacada-title">
  <div class="container-site">
    <div class="border-line rounded-card grid overflow-hidden border lg:grid-cols-12" data-reveal>
      <div class="relative lg:col-span-5">
        <MediaFrame
          src={courseImage}
          alt="Profesional de la visita médica preparando una reunión con su portátil"
          placeholder="Fotografía: profesional de la visita médica preparando una reunión"
          aspect="4 / 3"
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="rounded-none! lg:absolute! lg:inset-0 lg:aspect-auto!"
        />
      </div>

      <div class="p-7 sm:p-10 lg:col-span-7 lg:p-14">
        <p class="eyebrow">Formación destacada</p>
        <h2 id="formacion-destacada-title" class="text-h2 mt-4">{featuredCourse.title}</h2>
        <p class="text-lead text-muted mt-5 max-w-xl">{featuredCourse.summary}</p>

        <div class="mt-10 grid gap-10 md:grid-cols-2">
          <div>
            <h3 class="text-muted font-sans text-xs font-semibold tracking-[0.14em] uppercase">Aplicaciones</h3>
            <ul class="mt-4 space-y-2.5">
              {
                featuredCourse.applications.map((item) => (
                  <li class="text-ink flex items-start gap-2.5">
                    <Icon name="check" size={18} class="text-accent-strong mt-0.5" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3 class="text-muted font-sans text-xs font-semibold tracking-[0.14em] uppercase">Características</h3>
            <ul class="mt-4 space-y-2.5">
              {
                featuredCourse.features.map((item) => (
                  <li class="text-ink flex items-start gap-2.5">
                    <Icon name={item.icon} size={18} class="text-brand mt-0.5" />
                    {item.label}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="border-line mt-10 border-t pt-8">
          <Button href={featuredCourse.href} size="lg" arrow>Ver programa completo</Button>
        </div>
      </div>
    </div>
  </div>
</section>
