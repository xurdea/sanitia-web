---
import Button from '../Button.astro';
import MediaFrame from '../MediaFrame.astro';
import Icon from '../Icon.astro';
import { featuredCourse } from '../../data/content';
import { hero, training } from '../../data/home';

/**
 * Para añadir una fotografía real: colocarla en src/assets/home/ e importarla aquí, p. ej.
 *   import heroImage from '../../assets/home/hero.jpg';
 * Mientras no exista, en escritorio se muestra el panel del programa disponible
 * (sin placeholder fotográfico). En móvil la columna visual no se muestra.
 */
const heroImage = undefined;
---

<section class="border-line relative overflow-hidden border-b bg-white">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background-image: linear-gradient(rgb(18 59 109 / 0.035) 1px, transparent 1px), linear-gradient(90deg, rgb(18 59 109 / 0.035) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 80% at 80% 20%, black, transparent 75%);"
  >
  </div>

  <div class="container-site relative grid items-center gap-12 pt-10 pb-14 sm:pt-14 sm:pb-16 lg:grid-cols-12 lg:gap-10 lg:pt-24 lg:pb-28">
    <div class="lg:col-span-7">
      <p class="eyebrow mb-5 flex items-start gap-3 sm:mb-6 sm:items-center">
        <span aria-hidden="true" class="bg-accent mt-[0.55em] h-px w-6 shrink-0 sm:mt-0 sm:w-8"></span>
        {hero.eyebrow}
      </p>

      <h1 class="text-display max-w-[15ch]">
        Cursos de IA para <span class="text-brand">profesionales sanitarios</span>
      </h1>

      <p class="text-lead text-muted mt-6 max-w-xl sm:mt-7">{hero.text}</p>

      <div class="mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row">
        <Button href={hero.primary.href} size="lg" arrow>{hero.primary.label}</Button>
        <Button href={hero.secondary.href} size="lg" variant="secondary">{hero.secondary.label}</Button>
      </div>
    </div>

    <div class="relative hidden lg:col-span-5 lg:block">
      {
        heroImage ? (
          <>
            <MediaFrame
              src={heroImage}
              alt="Profesionales del sector sanitario trabajando con documentación y ordenador"
              aspect="4 / 5"
              priority
              sizes="40vw"
              class="border-line border"
            />
            <div class="border-line shadow-lift absolute -bottom-6 -left-10 max-w-[17rem] rounded-xl border bg-white p-5">
              <p class="text-brand-deep font-display text-sm font-bold">El enfoque SanitIA</p>
              <ul class="text-muted mt-3 space-y-2 text-sm">
                {hero.approach.map((item) => (
                  <li class="flex items-center gap-2">
                    <Icon name="check" size={16} class="text-accent-strong" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </>
        ) : (
          <div class="border-line rounded-card shadow-lift relative ml-auto max-w-md border bg-white p-8 xl:p-10">
            <div aria-hidden="true" class="bg-accent absolute top-0 left-8 h-1 w-16 xl:left-10" />
            <p class="eyebrow">{training.featured.badge}</p>
            <p class="font-display text-brand-deep mt-3 text-2xl leading-tight font-bold tracking-tight">
              {featuredCourse.title}
            </p>
            <ul class="mt-5 flex flex-wrap gap-2" aria-label="Datos del programa">
              {training.featured.facts.map((fact) => (
                <li class="bg-accent-wash text-brand-deep rounded-md px-2.5 py-1 text-sm font-medium">{fact}</li>
              ))}
            </ul>
            <div class="border-line mt-7 border-t pt-6">
              <p class="text-brand-deep font-display text-sm font-bold">El enfoque SanitIA</p>
              <ul class="text-muted mt-3 space-y-2 text-[0.9375rem]">
                {hero.approach.map((item) => (
                  <li class="flex items-center gap-2">
                    <Icon name="check" size={16} class="text-accent-strong" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
            <a
              href={featuredCourse.href}
              class="text-brand hover:text-brand-deep mt-7 inline-flex min-h-11 items-center gap-1.5 text-[0.9375rem] font-semibold transition-colors"
            >
              {training.featured.cta}
              <span class="sr-only">: {featuredCourse.title}</span>
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>
