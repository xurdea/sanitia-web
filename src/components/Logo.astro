---
/**
 * PENDIENTE: sustituir por el logotipo oficial de SanitIA (SVG) cuando esté disponible.
 * Mientras tanto se usa el nombre de marca en texto, sin símbolo gráfico inventado.
 */
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}

const { variant = 'dark', class: className } = Astro.props;
---

<span
  class:list={[
    'font-display text-[1.375rem] leading-none font-extrabold tracking-[-0.03em]',
    variant === 'dark' ? 'text-brand-deep' : 'text-white',
    className,
  ]}
>
  Sanit<span class={variant === 'dark' ? 'text-accent-strong' : 'text-accent'}>IA</span>
</span>
