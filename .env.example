# Configuración del despliegue. La web no usa secretos.
# Copiar a .env y ajustar. Tras cambiar SITE_URL o SITE_NOINDEX:
#   docker compose up -d --build

# URL pública con la que se accede a la web (sin barra final). Se usa para las
# URL canónicas, el sitemap y robots.txt.
SITE_URL=http://localhost:8090

# true  = la web no se indexa (robots.txt bloquea y cada página lleva noindex).
# false = indexable. Ponerlo a false solo cuando la web sea definitiva.
SITE_NOINDEX=true

# Dónde escucha el contenedor en el servidor.
#   127.0.0.1:8090     solo localhost (detrás de ngrok o Caddy)   <- por defecto
#   100.x.x.x:8090     solo por Tailscale (IP del servidor en la tailnet)
WEB_PORT=127.0.0.1:8090
