---
import MethodSteps from '../MethodSteps.astro';
import Button from '../Button.astro';
---

<section class="section-y" aria-labelledby="metodo-title">
  <div class="container-site">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between" data-reveal>
      <div class="max-w-2xl">
        <p class="eyebrow mb-4">Método SanitIA</p>
        <h2 id="metodo-title" class="text-h2">Aprender. Aplicar. Integrar.</h2>
        <p class="text-lead text-muted mt-5">
          Un proceso sencillo y flexible que parte de la comprensión y termina en el uso cotidiano de la IA.
        </p>
      </div>
      <Button href="/metodo-sanitia" variant="secondary" arrow class="self-start md:self-auto">Conocer el método</Button>
    </div>

    <div class="mt-14 lg:mt-20" data-reveal>
      <MethodSteps />
    </div>
  </div>
</section>
