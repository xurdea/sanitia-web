---
/**
 * Hero de la Home: titular protagonista, columna visual y la tarjeta "Ejemplo de tarea".
 * No repite los datos de los cursos (están en Formación); solo los enlaza.
 *
 * Columna de margen:
 * - Sin fotografía (estado actual): notas al margen editoriales. Una frase con los ámbitos del sector
 *   (CLAUDE.md §8.1) y el ejemplo de tarea como lista de verificación, sin tarjeta. Es un diseño terminado.
 * - Con fotografía: foto documental con la tarjeta de ejemplo flotando sobre su borde.
 *
 * Movimiento: el texto (H1 incluido) es estático desde el primer fotograma.
 * Solo se mueven el subrayado de "trabajo real" (se dibuja una vez) y la tarjeta de ejemplo.
 */
import type { ImageMetadata } from 'astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import MediaFrame from '../MediaFrame.astro';
import ExampleTask from './ExampleTask.astro';
import SourceSheet from './SourceSheet.astro';
import { hero } from '../../data/home';

/**
 * Fotografía real del Hero (pendiente). Para usarla:
 *   1. Guardarla en src/assets/home/ (p. ej. hero-documento.jpg, vertical, ≥ 1600 px de alto).
 *   2. Importarla aquí:  import heroImage from '../../assets/home/hero-documento.jpg';
 *   3. Borrar la línea `const heroImage = undefined;`.
 * La proporción la decide --hero-photo-aspect (16/9 en móvil y tableta, 4/5 en escritorio).
 */
const heroImage: ImageMetadata | undefined = undefined;

// Separa el titular para unir y subrayar "trabajo real" sin reescribir el texto.
const [titleBefore, titleAfter = ''] = hero.title.split(hero.titleEmphasis);

// Apoyo textual de §8.1 como frase de nota al margen: "Para todo el sector sanitario: asistencia, …, y tecnología."
const areaWords = hero.areas.map((area) => area.toLowerCase());
const areasSentence = `${hero.areasLabel}: ${areaWords.slice(0, -1).join(', ')} y ${areaWords.at(-1)}.`;
---

<section class="hero border-line relative border-b bg-white" aria-labelledby="hero-title">
  <div class="container-site grid gap-y-8 pt-8 pb-8 sm:gap-y-10 sm:pt-16 sm:pb-16 lg:grid-cols-12 lg:gap-x-12 lg:pt-24 lg:pb-24 xl:gap-x-16">
    <!-- Texto: estático (sin animación de entrada). Sin antetítulo: el titular se presenta solo. -->
    <div class="lg:col-span-7 lg:self-center">
      <h1 id="hero-title" class="hero-title">
        {titleBefore}<span class="hero-emphasis">{hero.titleEmphasis}</span>{titleAfter}
      </h1>

      <p class="text-lead text-muted mt-6 max-w-[34rem] sm:mt-8">{hero.lead}</p>

      <div class="mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row">
        <Button href={hero.primary.href} size="lg" arrow>{hero.primary.label}</Button>
        <Button href={hero.secondary.href} size="lg" variant="secondary">{hero.secondary.label}</Button>
      </div>

      <!-- Acceso discreto a los dos cursos, sin repetir sus datos -->
      <ul class="mt-4 flex flex-col sm:mt-8 sm:flex-row sm:gap-8" aria-label="Cursos">
        {
          hero.courses.map((course) => (
            <li>
              <a href={course.href} class="course-link text-brand-deep hover:text-brand group inline-flex min-h-11 items-center gap-1.5 text-[0.9375rem] font-semibold">
                {course.label}
                <Icon name="arrow-right" size={16} class="course-arrow text-accent-strong" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Columna visual: foto + ejemplo flotante (cuando exista la foto) o pieza editorial de revisión de una fuente -->
    {
      heroImage ? (
        <div class="hero-visual relative lg:col-span-5 lg:col-start-8 lg:self-center">
          <MediaFrame
            src={heroImage}
            alt={hero.photoAlt}
            aspect="var(--hero-photo-aspect)"
            priority
            sizes="(min-width: 1024px) 40vw, 100vw"
            class="border-line border"
          />
          <ExampleTask class="hero-example" />
        </div>
      ) : (
        <div class="hero-review lg:col-span-5 lg:col-start-8 lg:self-center">
          <div class="review">
            <SourceSheet class="review-source" />
            <ExampleTask variant="slip" class="review-slip" />
          </div>
          <p class="hero-areas-note">{areasSentence}</p>
        </div>
      )
    }
  </div>
</section>

<style>
  /*
   * Titular editorial en Newsreader (serif con tamaño óptico): peso medio, sin el tracking extremo de la sans.
   * "aplicada al trabajo real" mide ~9,6em: con 10em de ancho máximo la composición es
   * "Inteligencia artificial / aplicada al trabajo real / en sanidad" desde 390 px. En escritorio
   * el tamaño se limita (ver la media query de 64rem) para que esos 10em quepan en la columna de 7/12.
   */
  .hero-title {
    max-width: 10em;
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-size: min(clamp(2.375rem, 1.2rem + 4vw, 3.5rem), 11vw);
    line-height: 1.02;
    letter-spacing: -0.022em;
    font-weight: 500;
    color: var(--color-brand-deep);
    text-wrap: pretty;
  }

  /* "trabajo real" nunca se parte; su subrayado es la línea de verificación (turquesa = señal). */
  .hero-emphasis {
    position: relative;
    white-space: nowrap;
    color: var(--color-brand);
  }

  .hero-emphasis::after {
    content: '';
    position: absolute;
    left: 0.02em;
    right: 0.02em;
    /* Bajo la línea base: no roza el descendente de la «j». */
    bottom: -0.05em;
    height: 0.07em;
    min-height: 3px;
    border-radius: 2px;
    background: var(--color-accent);
    transform-origin: left center;
  }

  /* Proporción de la foto sin forzar estilos de MediaFrame. Mientras sea una reserva, en móvil y tableta
     es apaisada (16/9) para no dominar el Hero; en escritorio, vertical. */
  .hero-visual {
    --hero-photo-aspect: 16 / 9;
  }

  .hero-visual :global(.hero-example) {
    position: relative;
    margin: -3.5rem 0.75rem 0;
  }

  @media (width >= 40rem) {
    .hero-visual :global(.hero-example) {
      max-width: 21rem;
      margin: -5rem 0 0 1.5rem;
    }
  }

  @media (width >= 64rem) {
    .hero-visual {
      --hero-photo-aspect: 4 / 5;
    }

    /* La tarjeta flota sobre el borde izquierdo de la foto sin invadir el texto. */
    .hero-visual :global(.hero-example) {
      position: absolute;
      left: -1.5rem;
      bottom: -2rem;
      width: 19.5rem;
      margin: 0;
    }
  }

  @media (width >= 80rem) {
    .hero-visual :global(.hero-example) {
      left: -2.5rem;
    }
  }

  /*
   * Pieza de revisión (sin fotografía): la hoja «Documento original» con pasajes marcados y, superpuesta en
   * su esquina inferior izquierda, la nota de revisión con la tarea y sus comprobaciones.
   * En móvil solo se muestra la nota (sin papel): la hoja alargaría el Hero sin añadir información.
   */
  .hero-review {
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
  }

  .review :global(.review-source) {
    display: none;
  }

  /* En móvil no se muestra: alargaría el Hero y la sección Perfiles, justo después, detalla los mismos ámbitos. */
  .hero-areas-note {
    display: none;
    max-width: 30rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  @media (width >= 40rem) {
    .hero-review {
      border-top: 0;
      padding-top: 0;
      max-width: 34rem;
    }

    /* El relleno inferior fija cuánto baja la nota: tapa solo el último párrafo y deja ver los dos pasajes marcados. */
    .review {
      position: relative;
      padding-bottom: 12rem;
    }

    .review :global(.review-source) {
      display: block;
      width: 86%;
      margin-left: auto;
    }

    /* La nota cubre la parte baja de la hoja y sobresale por la izquierda: se lee primero la fuente marcada. */
    .review :global(.review-slip) {
      position: absolute;
      left: 0;
      bottom: 0;
      width: min(21rem, 78%);
    }

    .hero-areas-note {
      display: block;
      margin-top: 2rem;
    }
  }

  @media (width >= 64rem) {
    .hero-review {
      max-width: none;
    }
  }

  /* Escritorio: el titular cabe en 3 líneas dentro de la columna de 7/12 (10em ≤ ancho de columna). */
  @media (width >= 64rem) {
    .hero-title {
      font-size: min(4rem, 5.1vw);
    }
  }

  .course-link {
    -webkit-tap-highlight-color: transparent;
    transition: color 200ms ease, opacity 120ms ease-out;
  }

  /* Respuesta inmediata al tocar (sin movimiento: válida también con movimiento reducido). */
  .course-link:active {
    opacity: 0.7;
  }

  :global(.course-arrow) {
    transition: transform 200ms var(--ease-out-soft);
  }

  /* Hover solo en dispositivos con puntero fino: evita estados pegados en táctil. */
  @media (hover: hover) and (pointer: fine) {
    .course-link:hover :global(.course-arrow) {
      transform: translateX(2px);
    }
  }

  /* El subrayado se dibuja una sola vez; el texto ya es visible desde el inicio. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-emphasis::after {
      animation: emphasis-draw 420ms cubic-bezier(0.23, 1, 0.32, 1) 250ms both;
    }
  }

  @keyframes emphasis-draw {
    from {
      transform: scaleX(0);
    }
  }
</style>
