---
/**
 * Iconografía lineal única del sitio (trazo 1.5, rejilla 24x24, estilo Lucide).
 * Decorativos por defecto (aria-hidden). Pasar `label` si el icono transmite información.
 */
import { icons, type IconName } from '../lib/icons';

export type { IconName };

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 24, class: className, label } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['shrink-0', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icons[name]}
/>
