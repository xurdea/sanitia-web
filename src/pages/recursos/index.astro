---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { getPublishedResources } from '../../lib/resources';

const resources = await getPublishedResources();
---

<BaseLayout
  title="Guías de IA para profesionales sanitarios"
  description="Guías prácticas para buscar y verificar información clínica con IA, trabajar con documentación y aplicar herramientas de inteligencia artificial en sanidad."
>
  <PageHero
    eyebrow="Recursos"
    title="Guías prácticas de IA para el sector sanitario"
    intro="Búsqueda de información clínica, verificación de fuentes, documentación y casos de uso de inteligencia artificial para profesionales de la salud."
  />

  <section class="section-y" aria-label="Listado de recursos">
    <div class="container-site">
      {
        resources.length > 0 ? (
          <div class="grid gap-x-10 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
            {resources.map((entry) => (
              <ResourceCard entry={entry} headingLevel="h2" />
            ))}
          </div>
        ) : (
          <p class="text-muted text-lead">Próximamente publicaremos nuevos recursos.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
