---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import UseCases from '../components/home/UseCases.astro';
import FeaturedCourse from '../components/home/FeaturedCourse.astro';
import Profiles from '../components/home/Profiles.astro';
import Credibility from '../components/home/Credibility.astro';
import Method from '../components/home/Method.astro';
import Organizations from '../components/home/Organizations.astro';
import CTASection from '../components/CTASection.astro';
import { homeSeo, finalCta } from '../data/home';

// La sección de recursos (components/home/Resources.astro) no se renderiza
// mientras sus contenidos están en revisión editorial.
---

<BaseLayout title={homeSeo.title} description={homeSeo.description}>
  <Hero />
  <UseCases />
  <FeaturedCourse />
  <Profiles />
  <Credibility />
  <Method />
  <Organizations />
  <CTASection title={finalCta.title} text={finalCta.text} primary={finalCta.primary} />
</BaseLayout>
