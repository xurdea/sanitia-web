---
/**
 * Marco de imagen sustituible.
 * - Con `src` (ImageMetadata importada desde src/assets) renderiza una imagen optimizada.
 * - Sin `src` muestra un placeholder abstracto y discreto con la descripción de la foto pendiente.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** Descripción de la fotografía que debe ir aquí (se muestra en el placeholder). */
  placeholder?: string;
  aspect?: string;
  tone?: 'light' | 'deep';
  priority?: boolean;
  sizes?: string;
  /** Posición de la etiqueta del placeholder. */
  captionPosition?: 'top' | 'bottom';
  /**
   * Placeholder plano: sin cuadrícula, halos ni tinte; solo una reserva de composición neutra con su etiqueta.
   * Por defecto (false) se mantiene el placeholder actual.
   */
  plain?: boolean;
  class?: string;
}

const {
  src,
  alt = '',
  placeholder = 'Fotografía pendiente',
  aspect = '4 / 3',
  tone = 'light',
  priority = false,
  sizes = '(min-width: 1024px) 50vw, 100vw',
  captionPosition = 'bottom',
  plain = false,
  class: className,
} = Astro.props;
---

<figure
  class:list={['rounded-card relative isolate overflow-hidden', className]}
  style={`aspect-ratio: ${aspect}`}
>
  {
    src ? (
      <Image
        src={src}
        alt={alt}
        sizes={sizes}
        widths={[480, 800, 1200, 1600]}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="absolute inset-0 size-full object-cover"
      />
    ) : (
      <div
        class:list={[
          'absolute inset-0',
          plain ? 'bg-surface' : tone === 'deep' ? 'bg-brand-deep' : 'bg-surface-alt',
        ]}
        role="img"
        aria-label={`Espacio reservado: ${placeholder}`}
      >
        {!plain && (
          <>
        <div
          class="absolute inset-0"
          style={`--g: ${tone === 'deep' ? 'rgb(255 255 255 / 0.05)' : 'rgb(18 59 109 / 0.06)'}; background-image: linear-gradient(var(--g) 1px, transparent 1px), linear-gradient(90deg, var(--g) 1px, transparent 1px); background-size: 28px 28px;`}
        />
        <div
          class:list={[
            'absolute -right-[15%] -bottom-[25%] aspect-square w-[70%] rounded-full blur-3xl',
            tone === 'deep' ? 'bg-accent/15' : 'bg-accent-soft/35',
          ]}
        />
        <div
          class:list={[
            'absolute -top-[20%] -left-[10%] aspect-square w-[50%] rounded-full blur-3xl',
            tone === 'deep' ? 'bg-brand/60' : 'bg-white/80',
          ]}
        />
          </>
        )}
        <span
          data-caption
          aria-hidden="true"
          class:list={[
            'absolute left-3 inline-flex max-w-[calc(100%-1.5rem)] items-center gap-2 rounded-md px-2.5 py-1.5 text-xs font-medium',
            captionPosition === 'top' ? 'top-3' : 'bottom-3',
            tone === 'deep' ? 'bg-white/10 text-slate-200' : 'bg-white/85 text-muted',
          ]}
        >
          <Icon name="image" size={14} />
          <span class="truncate">{placeholder}</span>
        </span>
      </div>
    )
  }
  <slot />
</figure>
