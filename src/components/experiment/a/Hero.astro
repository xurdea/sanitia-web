---
/**
 * EXPERIMENTO A/B · Variante A (sin skill) · Hero
 * Concepto: "precisión serena". Un titular protagonista, una sola foto documental
 * y una tarjeta flotante con un ejemplo de tarea verificada (la "línea de verificación").
 * No repite los datos de los cursos: están en la sección Formación, justo debajo.
 */
import Button from '../../Button.astro';
import Icon from '../../Icon.astro';
import MediaFrame from '../../MediaFrame.astro';
import ExampleTask from './ExampleTask.astro';
import { experimentHero as hero } from '../../../data/experiment';

/**
 * Fotografía pendiente. Para sustituir el hueco reservado por la foto real:
 *   1. Guardarla en src/assets/home/ (p. ej. hero-documento.jpg, vertical, ≥ 1600 px de alto).
 *   2. Importarla aquí:  import heroImage from '../../../assets/home/hero-documento.jpg';
 *   3. Borrar la línea `const heroImage = undefined;`.
 * MediaFrame la optimiza (srcset, formatos modernos) y usa hero.photoAlt como texto alternativo.
 */
const heroImage = undefined;

// Separa el titular para dar énfasis a "trabajo real" sin reescribir el texto.
const [titleBefore, titleAfter = ''] = hero.title.split(hero.titleEmphasis);
---

<section class="hero border-line relative border-b bg-white" aria-labelledby="hero-title">
  <div class="container-site grid items-center gap-y-10 pt-10 pb-16 sm:pt-14 lg:grid-cols-12 lg:grid-rows-[1fr_auto] lg:gap-x-12 lg:pt-20 lg:pb-24 xl:gap-x-16">
    <!-- Texto -->
    <div class="hero-copy lg:col-span-7 lg:col-start-1 lg:row-start-1 lg:self-end">
      <p class="eyebrow">{hero.kicker}</p>

      <h1 id="hero-title" class="hero-title mt-5 max-w-[14ch] sm:mt-6">
        {titleBefore}<span class="hero-emphasis">{hero.titleEmphasis}</span>{titleAfter}
      </h1>

      <p class="text-lead text-muted mt-6 max-w-[34rem] sm:mt-8">{hero.lead}</p>

      <div class="mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row">
        <Button href={hero.primary.href} size="lg" arrow>{hero.primary.label}</Button>
        <Button href={hero.secondary.href} size="lg" variant="secondary">{hero.secondary.label}</Button>
      </div>
    </div>

    <!-- Visual: fotografía documental + ejemplo de tarea flotante (también en móvil) -->
    <div class="hero-visual relative lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1">
      <MediaFrame
        src={heroImage}
        alt={hero.photoAlt}
        placeholder={hero.photoBrief}
        aspect="4 / 5"
        priority
        sizes="(min-width: 1024px) 40vw, 100vw"
        captionPosition="top"
        class="hero-photo border-line border"
      />
      <ExampleTask class="hero-example" />
    </div>

    <!-- Acceso discreto a los dos cursos, sin repetir sus datos -->
    <ul class="hero-courses border-line flex flex-col border-t sm:flex-row sm:gap-8 lg:col-span-7 lg:col-start-1 lg:row-start-2 lg:self-start">
      {
        hero.courses.map((course) => (
          <li>
            <a href={course.href} class="course-link text-brand-deep hover:text-brand group inline-flex min-h-11 items-center gap-1.5 pt-3 text-[0.9375rem] font-semibold">
              {course.label}
              <Icon name="arrow-right" size={16} class="text-accent-strong ease-out-soft transition-transform duration-200 group-hover:translate-x-0.5" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero-title {
    font-size: clamp(2.375rem, 1.5rem + 3.4vw, 4.25rem);
    line-height: 1.03;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--color-brand-deep);
  }

  /* Énfasis: el subrayado es la "línea de verificación" (turquesa = señal). */
  .hero-emphasis {
    color: var(--color-brand);
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.12em;
    text-decoration-skip-ink: none;
  }

  /* Móvil: foto apaisada y tarjeta superpuesta en la parte baja. */
  .hero-visual :global(.hero-photo) {
    aspect-ratio: 4 / 3 !important;
  }

  .hero-visual :global(.hero-example) {
    position: relative;
    margin: -3.5rem 0.75rem 0;
  }

  @media (width >= 40rem) {
    .hero-visual :global(.hero-example) {
      max-width: 21rem;
      margin: -5rem 0 0 1.5rem;
    }
  }

  /* Escritorio: foto vertical y tarjeta flotando sobre el borde izquierdo. */
  @media (width >= 64rem) {
    .hero-visual :global(.hero-photo) {
      aspect-ratio: 4 / 5 !important;
    }

    .hero-visual :global(.hero-example) {
      position: absolute;
      left: -2.5rem;
      bottom: -2rem;
      width: 19.5rem;
      margin: 0;
    }
  }

  .course-link {
    transition: color 200ms var(--ease-out-soft);
  }

  /* Entrada inicial única. Estado por defecto = final; solo se anima si se acepta movimiento. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy {
      animation: hero-rise 500ms var(--ease-out-soft) both;
    }

    .hero-visual,
    .hero-courses {
      animation: hero-rise 500ms 120ms var(--ease-out-soft) both;
    }

    .hero-visual :global(.hero-example) {
      animation: hero-rise 450ms 320ms var(--ease-out-soft) both;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
</style>
