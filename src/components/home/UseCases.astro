---
import Icon from '../Icon.astro';
import { applications } from '../../data/home';
---

<section class="py-12 sm:py-16 lg:py-24" aria-labelledby="aplicaciones-title">
  <div class="container-site">
    <div class="grid gap-5 lg:grid-cols-12 lg:items-end lg:gap-10" data-reveal>
      <div class="lg:col-span-7">
        <p class="eyebrow mb-4">Aplicaciones</p>
        <h2 id="aplicaciones-title" class="text-h2">{applications.title}</h2>
      </div>
      <p class="text-lead text-muted lg:col-span-5">{applications.intro}</p>
    </div>

    <ul
      class="bg-line border-line rounded-card mt-8 grid grid-cols-2 gap-px overflow-hidden border sm:mt-10 lg:mt-12 lg:grid-cols-3"
      data-reveal
    >
      {
        applications.items.map((item) => (
          <li class="flex flex-col gap-3 bg-white p-4 sm:flex-row sm:items-center sm:gap-4 sm:p-6 lg:p-7">
            <span class="bg-accent-wash text-brand inline-flex size-10 shrink-0 items-center justify-center rounded-lg sm:size-11">
              <Icon name={item.icon} size={22} />
            </span>
            <h3 class="text-[0.9375rem] leading-snug font-bold sm:text-lg">{item.title}</h3>
          </li>
        ))
      }
    </ul>
  </div>
</section>
