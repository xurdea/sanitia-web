---
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { organizations } from '../../data/home';
---

<section class="bg-surface-alt py-12 sm:py-16 lg:py-24" aria-labelledby="organizaciones-title">
  <div class="container-site grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-10">
    <div class="lg:col-span-5" data-reveal>
      <p class="eyebrow mb-4">Organizaciones</p>
      <h2 id="organizaciones-title" class="text-h2">{organizations.title}</h2>
      <p class="text-lead text-muted mt-5">{organizations.text}</p>
      <div class="mt-8 hidden lg:block">
        <Button href={organizations.cta.href} size="lg" arrow>{organizations.cta.label}</Button>
      </div>
    </div>

    <div class="lg:col-span-6 lg:col-start-7" data-reveal>
      <ul class="grid grid-cols-2 gap-3 sm:gap-4" aria-label="Tipos de organización">
        {
          organizations.types.map((type) => (
            <li class="border-line flex items-center gap-3 rounded-xl border bg-white p-3.5 sm:gap-4 sm:p-5">
              <Icon name={type.icon} size={22} class="text-brand" />
              <span class="font-display text-brand-deep text-[0.9375rem] leading-snug font-semibold sm:text-base">
                {type.label}
              </span>
            </li>
          ))
        }
      </ul>
      <div class="mt-8 lg:hidden">
        <Button href={organizations.cta.href} size="lg" arrow class="w-full sm:w-auto">{organizations.cta.label}</Button>
      </div>
    </div>
  </div>
</section>
