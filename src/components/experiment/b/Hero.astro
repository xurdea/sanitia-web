---
/**
 * EXPERIMENTO A/B · Variante B (SanitIA + principios de apple-design-skill).
 *
 * Una sola idea: "IA aplicada al trabajo real". Jerarquía por escala tipográfica,
 * no por cajas. Foco visual = fotografía documental + panel flotante con un
 * EJEMPLO de tarea recorrida con la "línea de verificación" (anticipa el Método).
 *
 * Profundidad en tres niveles: plano (fondo surface) · panel elevado (foto) ·
 * elemento flotante (ejemplo de tarea).
 *
 * Fotografía real: colocarla en src/assets/home/ e importarla aquí, p. ej.
 *   import heroImage from '../../../assets/home/hero.jpg';
 * y pasarla a <MediaFrame src={heroImage} alt={experimentHero.photoAlt} priority ... />.
 * Mientras no exista, MediaFrame muestra el hueco reservado con experimentHero.photoBrief.
 */
import type { ImageMetadata } from 'astro';
import Button from '../../Button.astro';
import MediaFrame from '../../MediaFrame.astro';
import Icon from '../../Icon.astro';
import { experimentHero as hero } from '../../../data/experiment';

const heroImage: ImageMetadata | undefined = undefined;

// Separa el título para dar énfasis al fragmento indicado sin reescribir el copy.
const [titleBefore, titleAfter] = hero.title.split(hero.titleEmphasis);
const doneCount = hero.example.checks.filter((c) => c.done).length;
---

<section class="hero-b border-line bg-surface relative overflow-hidden border-b" aria-labelledby="hero-b-title">
  <div
    class="container-site grid items-center gap-y-12 pt-10 pb-16 sm:pt-14 lg:grid-cols-12 lg:gap-x-12 lg:pt-20 lg:pb-24 xl:gap-x-16"
  >
    <!-- Texto: una idea, escala fuerte -->
    <div class="hero-b-copy lg:col-span-7">
      <p class="eyebrow">{hero.kicker}</p>

      <h1 id="hero-b-title" class="hero-b-title text-brand-deep mt-5 sm:mt-6">
        {titleBefore}<span class="hero-b-emph">{hero.titleEmphasis}</span>{titleAfter}
      </h1>

      <p class="text-lead text-muted mt-6 max-w-[34rem] sm:mt-7">{hero.lead}</p>

      <div class="mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row sm:items-center">
        <Button href={hero.primary.href} size="lg" arrow class="hero-b-btn">{hero.primary.label}</Button>
        <Button href={hero.secondary.href} size="lg" variant="secondary" class="hero-b-btn">{hero.secondary.label}</Button>
      </div>
    </div>

    <!-- Visual: foto (panel elevado) + ejemplo (elemento flotante). Visible también en móvil. -->
    <div class="hero-b-visual relative lg:col-span-5">
      <div class="relative aspect-[4/3] w-full sm:aspect-[16/11] lg:ml-auto lg:aspect-[4/5] lg:max-w-[30rem]">
        <MediaFrame
          src={heroImage}
          alt={hero.photoAlt}
          placeholder={hero.photoBrief}
          captionPosition="top"
          priority
          sizes="(min-width: 1024px) 480px, 100vw"
          class="border-line shadow-soft h-full! w-full border bg-white"
        />
      </div>

      <!-- Ejemplo ilustrativo: se presenta como ejemplo, no como dato real -->
      <aside
        class="hero-b-example border-line shadow-lift relative mx-4 -mt-20 rounded-[var(--radius-card)] border bg-white p-5 sm:mx-auto sm:-mt-24 sm:max-w-[22rem] sm:p-6 lg:absolute lg:bottom-10 lg:-left-10 lg:mx-0 lg:mt-0 lg:w-[20.5rem]"
        aria-labelledby="hero-b-example-task"
      >
        <p
          class="border-line-strong text-muted inline-flex items-center gap-1.5 rounded-full border border-dashed px-2.5 py-1 text-[0.6875rem] font-semibold tracking-[0.12em] uppercase"
        >
          <Icon name="file-text" size={13} />
          {hero.example.label}
        </p>
        <p id="hero-b-example-task" class="font-display text-brand-deep mt-3 text-[1.0625rem] leading-snug font-bold">
          {hero.example.task}
        </p>

        <ol class="hero-b-checks mt-4" aria-label={`${doneCount} de ${hero.example.checks.length} pasos completados`}>
          {
            hero.example.checks.map((check) => (
              <li class:list={['hero-b-check', check.done ? 'is-done' : 'is-pending']}>
                <span class="hero-b-node" aria-hidden="true">
                  {check.done && <Icon name="check" size={12} class="stroke-[2.5]" />}
                </span>
                <span class:list={['text-sm leading-snug', check.done ? 'text-ink' : 'text-muted']}>
                  {check.text}
                  <span class="sr-only">{check.done ? ' (completado)' : ' (pendiente)'}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
  </div>
</section>

<style>
  /* Titular: escala dramática con tracking negativo creciente (marketing-pages / Font strategy) */
  .hero-b-title {
    font-size: clamp(2.375rem, 1.5rem + 3.4vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.038em;
    font-weight: 750;
    max-width: 15ch;
  }

  /* Énfasis: la "línea de verificación" subraya el trabajo real (turquesa = señal, no decoración) */
  .hero-b-emph {
    position: relative;
    white-space: nowrap;
    color: var(--color-brand);
  }
  .hero-b-emph::after {
    content: '';
    position: absolute;
    left: 0.02em;
    right: 0.02em;
    bottom: 0.02em;
    height: 3px;
    border-radius: 2px;
    background: var(--color-accent);
    transform-origin: left center;
  }

  /* Botones: feedback inmediato al pulsar (ligera atenuación + escala) */
  :global(.hero-b-btn:active) {
    transform: scale(0.98);
  }

  /* Lista del ejemplo con línea de verificación vertical */
  .hero-b-checks {
    position: relative;
    display: grid;
    gap: 0.7rem;
  }
  .hero-b-check {
    position: relative;
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    align-items: start;
    column-gap: 0.75rem;
  }
  /* Tramo de línea que une cada nodo con el siguiente */
  .hero-b-check:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(0.625rem - 1px);
    top: 1.25rem;
    height: calc(100% - 1.25rem + 0.7rem);
    width: 2px;
    background: var(--color-accent);
  }
  /* El tramo que llega al paso pendiente queda discontinuo y neutro: lo cierra el profesional */
  .hero-b-check.is-done:has(+ .is-pending)::before {
    background: repeating-linear-gradient(to bottom, var(--color-line-strong) 0 3px, transparent 3px 6px);
  }
  .hero-b-node {
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    margin-top: 0.0625rem;
  }
  .is-done .hero-b-node {
    background: var(--color-accent-strong);
    color: #fff;
  }
  .is-pending .hero-b-node {
    background: #fff;
    border: 1.5px dashed var(--color-line-strong);
  }

  /* Entrada inicial sutil, una sola vez. Estado por defecto = final (sin animación todo visible). */
  @media (prefers-reduced-motion: no-preference) {
    .hero-b-copy {
      animation: hero-b-rise 480ms var(--ease-out-soft) both;
    }
    .hero-b-visual {
      animation: hero-b-rise 480ms var(--ease-out-soft) 120ms both;
    }
    .hero-b-emph::after {
      animation: hero-b-draw 420ms var(--ease-out-soft) 380ms both;
    }
  }

  @keyframes hero-b-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes hero-b-draw {
    from {
      transform: scaleX(0);
    }
  }
</style>
