---
import { profiles } from '../../data/home';
---

<section class="py-12 sm:py-16 lg:py-24" aria-labelledby="perfiles-title">
  <div class="container-site">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow mb-4">Perfiles</p>
      <h2 id="perfiles-title" class="text-h2">{profiles.title}</h2>
    </div>

    <ul class="mt-8 grid gap-x-8 sm:mt-10 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3 lg:gap-x-10" data-reveal>
      {
        profiles.items.map((profile) => (
          <li class="border-line border-t py-4 sm:py-5">
            <h3 class="flex items-center gap-2.5 text-lg font-bold">
              <span aria-hidden="true" class="bg-accent size-1.5 shrink-0 rounded-full" />
              {profile.name}
            </h3>
            <p class="text-muted mt-1.5 text-[0.9375rem] leading-relaxed">{profile.text}</p>
          </li>
        ))
      }
    </ul>

    <p class="text-muted border-line border-t pt-5 text-sm" data-reveal>{profiles.note}</p>
  </div>
</section>
