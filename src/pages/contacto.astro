---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const reasons = [
  { icon: 'book', title: 'Formación para profesionales', text: 'Información sobre programas, próximas ediciones y condiciones.' },
  { icon: 'building', title: 'Propuestas para organizaciones', text: 'Formación adaptada a equipos, departamentos y organizaciones.' },
  { icon: 'message', title: 'Otras consultas', text: 'Colaboraciones, dudas generales o cualquier otra cuestión.' },
] as const;
---

<BaseLayout
  title="Contacto"
  description="Contacta con SanitIA para solicitar información sobre formación en inteligencia artificial aplicada al sector sanitario o una propuesta para tu organización."
>
  <PageHero
    eyebrow="Contacto"
    title="Hablemos"
    intro="Cuéntanos qué necesitas: información sobre un programa, una propuesta para tu equipo o cualquier otra consulta."
  />

  <section class="section-y">
    <div class="container-site grid gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <h2 class="text-3xl font-bold">¿En qué podemos ayudarte?</h2>
        <ul class="divide-line border-line mt-8 divide-y border-y">
          {
            reasons.map((r) => (
              <li class="flex gap-4 py-6">
                <Icon name={r.icon} size={24} class="text-brand mt-0.5" />
                <div>
                  <h3 class="text-lg font-bold">{r.title}</h3>
                  <p class="text-muted mt-1">{r.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div class="border-line shadow-soft rounded-card border bg-white p-6 sm:p-8">
          <span class="bg-accent-wash text-brand inline-flex size-12 items-center justify-center rounded-xl">
            <Icon name="mail" size={24} />
          </span>
          <h2 class="mt-6 text-2xl font-bold">Solicita información</h2>
          <p class="text-muted mt-3">Cuéntanos qué necesitas y te responderemos por correo electrónico.</p>
          <form
            name="contacto"
            method="POST"
            action="/contacto-enviado"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="mt-7 space-y-5"
          >
            <p class="hidden" aria-hidden="true">
              <label>No rellenes este campo: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>
            <div>
              <label for="contacto-nombre" class="text-brand-deep block text-sm font-semibold">Nombre *</label>
              <input id="contacto-nombre" name="nombre" type="text" autocomplete="name" maxlength="100" required
                class="border-line-strong mt-2 block w-full rounded-lg border bg-white px-4 py-3 text-brand-deep focus:border-brand focus:outline-2 focus:outline-offset-2 focus:outline-brand" />
            </div>
            <div>
              <label for="contacto-email" class="text-brand-deep block text-sm font-semibold">Correo electrónico *</label>
              <input id="contacto-email" name="email" type="email" autocomplete="email" maxlength="254" required
                class="border-line-strong mt-2 block w-full rounded-lg border bg-white px-4 py-3 text-brand-deep focus:border-brand focus:outline-2 focus:outline-offset-2 focus:outline-brand" />
            </div>
            <div>
              <label for="contacto-motivo" class="text-brand-deep block text-sm font-semibold">Motivo de la consulta *</label>
              <select id="contacto-motivo" name="motivo" required
                class="border-line-strong mt-2 block w-full rounded-lg border bg-white px-4 py-3 text-brand-deep focus:border-brand focus:outline-2 focus:outline-offset-2 focus:outline-brand">
                <option value="" disabled selected>Selecciona una opción</option>
                <option value="formacion">Información sobre formación</option>
                <option value="organizaciones">Propuesta para una organización</option>
                <option value="otra">Otra consulta</option>
              </select>
            </div>
            <div>
              <label for="contacto-mensaje" class="text-brand-deep block text-sm font-semibold">Mensaje *</label>
              <textarea id="contacto-mensaje" name="mensaje" rows="5" maxlength="2000" required
                class="border-line-strong mt-2 block w-full rounded-lg border bg-white px-4 py-3 text-brand-deep focus:border-brand focus:outline-2 focus:outline-offset-2 focus:outline-brand"
                placeholder="Indícanos qué información necesitas."></textarea>
              <p class="text-muted mt-2 text-xs">No incluyas datos de pacientes ni información sanitaria confidencial.</p>
            </div>
            <label class="text-muted flex items-start gap-3 text-sm">
              <input type="checkbox" name="novedades" value="si" class="mt-1 size-4 shrink-0 accent-[var(--color-brand)]" />
              <span>Quiero recibir por correo información sobre nuevos cursos de SanitIA. Es opcional y puedo darme de baja en cualquier momento.</span>
            </label>
            <p class="text-muted text-xs">
              Trataremos tus datos para responder a tu consulta. Consulta la <a href="/privacidad" class="text-brand underline underline-offset-4">política de privacidad</a>.
            </p>
            <button type="submit" class="bg-brand-deep shadow-soft hover:bg-brand h-13 w-full rounded-lg px-6 font-semibold text-white transition-colors focus:outline-2 focus:outline-offset-2 focus:outline-brand">
              Enviar consulta
            </button>
          </form>
          <p class="text-muted border-line mt-8 border-t pt-6 text-sm">
            También puedes escribir directamente a <a href={`mailto:${site.contactEmail}`} class="text-brand font-semibold underline underline-offset-4">{site.contactEmail}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
