---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import CourseFacts from '../../components/CourseFacts.astro';
import CTASection from '../../components/CTASection.astro';
import FollowUp from '../../components/FollowUp.astro';
import { featuredCourse, medicalCourse, ecosystem } from '../../data/content';
---

<BaseLayout
  title="Cursos de IA para médicos y profesionales sanitarios"
  description="Cursos de inteligencia artificial para médicos y visitadores médicos: programas prácticos de 10 horas y formación a medida para equipos sanitarios."
>
  <PageHero
    eyebrow="Formación"
    title="Cursos de IA para profesionales sanitarios"
    intro="Dos cursos de 10 horas para médicos y visita médica. También diseñamos programas de 10 horas en 5 sesiones para otros perfiles y equipos, a partir de sus tareas y necesidades reales."
  />

  <section class="section-y" aria-labelledby="programas-title">
    <div class="container-site">
      <h2 id="programas-title" class="text-h2">Programas disponibles</h2>

      <article class="border-line rounded-card mt-10 border bg-white p-6 sm:p-10 lg:p-12">
        <div class="max-w-3xl">
          <p class="eyebrow">Formación para médicos</p>
          <h3 class="mt-4 text-3xl font-bold">{medicalCourse.title}</h3>
          <p class="text-lead text-muted mt-4">{medicalCourse.summary}</p>
          <CourseFacts label="Datos del curso de IA para médicos" />
        </div>
        <div class="border-line mt-8 border-t pt-8">
          <ul class="flex flex-wrap gap-2" aria-label="Áreas de práctica del curso para médicos">
            {medicalCourse.applications.map((item) => (
              <li class="bg-surface-alt text-brand-deep rounded-full px-3.5 py-1.5 text-sm font-medium">{item}</li>
            ))}
          </ul>
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={medicalCourse.href} arrow>Ver programa para médicos</Button>
          <Button href="/contacto" variant="secondary">Solicitar información</Button>
        </div>
      </article>

      <article class="border-line rounded-card mt-6 border bg-white p-6 sm:p-10 lg:p-12">
        <div class="max-w-3xl">
          <p class="eyebrow">Visita médica · Industria farmacéutica</p>
          <h3 class="mt-4 text-3xl font-bold">{featuredCourse.title}</h3>
          <p class="text-lead text-muted mt-4">{featuredCourse.summary}</p>
          <CourseFacts label="Datos del curso de visita médica" />
        </div>
        <div class="border-line mt-8 border-t pt-8">
          <ul class="flex flex-wrap gap-2" aria-label="Áreas de práctica del curso de visita médica">
            {
              featuredCourse.applications.map((item) => (
                <li class="bg-surface-alt text-brand-deep rounded-full px-3.5 py-1.5 text-sm font-medium">{item}</li>
              ))
            }
          </ul>
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={featuredCourse.href} arrow>Ver programa completo</Button>
          <Button href="/contacto" variant="secondary">Solicitar información</Button>
        </div>
      </article>
      <div class="mt-8"><FollowUp /></div>
    </div>
  </section>

  <section class="section-y border-line border-t bg-white" aria-labelledby="perfiles-title">
    <div class="container-site grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow mb-4">Por perfil</p>
        <h2 id="perfiles-title" class="text-h2">Formación para cada perfil del sector salud</h2>
        <p class="text-lead text-muted mt-5">
          Además de los dos cursos disponibles, creamos formación a medida para enfermería, farmacia, gestión,
          administración y otros equipos sanitarios. Trabajamos sobre sus tareas y fuentes habituales, siguiendo las
          cuatro fases del <a href="/metodo-sanitia" class="text-brand underline underline-offset-4">Método SanitIA</a>.
        </p>
        <p class="text-muted mt-4 leading-relaxed">El formato propuesto es de 10 horas en 5 sesiones online en directo, con seis meses de seguimiento en Discord después del curso.</p>
        <Button href="/contacto" variant="secondary" arrow class="mt-8">Contactar con SanitIA</Button>
      </div>
      <ul class="divide-line border-line divide-y border-y lg:col-span-6 lg:col-start-7">
        {
          ecosystem.map((area) => (
            <li class="flex items-start gap-4 py-6">
              <Icon name={area.icon} size={24} class="text-brand mt-0.5" />
              <div>
                <h3 class="text-lg font-bold">{area.name}</h3>
                <p class="text-muted mt-1">{area.profiles.join(' · ')}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTASection
    title="¿Formación para un equipo completo?"
    text="Diseñamos programas adaptados a los perfiles, procesos y objetivos de cada organización."
    primary={{ label: 'Formación para empresas', href: '/empresas' }}
    secondary={{ label: 'Contactar', href: '/contacto' }}
  />
</BaseLayout>
